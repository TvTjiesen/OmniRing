    <string name="credits_liquid_use">Lens refraction, inner shadow and damped drag animation of the liquid glass nav bar</string>
    <string name="credits_yuki_use">Xposed hook framework, module entry and config storage</string>
    <string name="credits_kavaref_use">Reflection library used to reach hidden system APIs</string>
